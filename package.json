{
	"name": "bref-ui-workspace",
	"private": true,
	"type": "module",
	"workspaces": [
		"core",
		"themes",
		"docs"
	],
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-check-file": "^3.3.2",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1"
	},
	"scripts": {
		"dev": "bun run --cwd docs dev",
		"build:packages": "bun run --filter bref-ui --filter bref-ui-themes prepack",
		"check": "bun run --workspaces --if-present check && tsc -p tests/tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"build": "bun run --workspaces --if-present build",
		"preview": "bun run --cwd docs preview",
		"test": "bun run --cwd core test && playwright test",
		"test:browser": "playwright test"
	}
}
