{
	"name": "bref-ui",
	"version": "2.0.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"demo-site-build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "bun cli/pack.ts && bun run svelte-kit sync && bun run svelte-package && bun run publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"cli/**/*.ts",
		"src/lib"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts"
		},
		"./surface": {
			"types": "./dist/theme/surface.d.ts",
			"import": "./dist/theme/surface.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.56.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/syne": "^5.3.0",
		"@fontsource/meow-script": "5.2.8",
		"@fontsource/spectral": "5.2.8",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/bun": "^1.4.2",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-check-file": "^3.3.2",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"shiki": "^4.4.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@fontsource-variable/material-symbols-outlined": "^5.3.5"
	},
	"bin": {
		"bref-ui": "./cli/index.ts"
	}
}
