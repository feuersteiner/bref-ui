{
	"name": "bref-ui-themes",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "node ../scripts/package.mjs && svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"src/lib"
	],
	"sideEffects": [
		"**/*.css",
		"**/*.svelte"
	],
	"svelte": "./src/lib/index.ts",
	"types": "./src/lib/index.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts"
		}
	},
	"peerDependencies": {
		"svelte": "^5.57.1",
		"bref-ui": "^3.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"bref-ui": "workspace:*",
		"publint": "^0.3.21",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"keywords": [
		"svelte"
	],
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"description": "Pre-built turnkey beautiful themes using bref-ui.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feuersteiner/bref-ui.git",
		"directory": "themes"
	},
	"homepage": "https://github.com/feuersteiner/bref-ui#readme",
	"bugs": {
		"url": "https://github.com/feuersteiner/bref-ui/issues"
	},
	"dependencies": {
		"@fontsource-variable/material-symbols-outlined": "^5.3.5"
	}
}
